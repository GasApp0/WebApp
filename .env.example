# Create a copy of this file named `.env` and fill in your own values.
# CRA only picks up env vars prefixed with REACT_APP_, and the dev server
# must be restarted after changing them.

# Optional CARTO basemap API key for the Home page map (src/components/MapView.tsx).
# The map tiles work without one on light/dev usage; add a key from
# https://carto.com/ if you hit rate limits or want a paid account's tiles.
REACT_APP_MAP_TILE_KEY=
